# Copy to .env and adjust. Defaults below match docker-compose.yml.
DATABASE_URL=postgres://chat:chat@127.0.0.1:5432/chat
# Moving to a new database host: set this to the OLD database for one start; the data is
# copied into DATABASE_URL if that one has no members yet. Remove it afterwards.
# MIGRATE_FROM_URL=
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
# Long random string. Used to hash device ids and network prefixes (never stored raw).
SIGNAL_SECRET=change-me-to-a-long-random-string
# true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# console = print verification codes to the server log
MAIL_ADAPTER=console
# For real email: MAIL_ADAPTER=resend, RESEND_API_KEY=re_..., MAIL_FROM="RoleplayRetro <no-reply@yourdomain>"

# Where profile photos are stored (served at /uploads/)
UPLOAD_DIR=uploads
# Gold Quill passes (PayPal REST app from developer.paypal.com). Leave empty to keep passes "coming soon".
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox   # 'live' for real payments
# SITE_URL=https://roleplayretro.com
